    {
      "id": 23,
      "type": "table",
      "title": "Services",
      "description": "Each service's health endpoint, checked every 30 seconds.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "max by (service) (probe_success{job=\"services\"})"
        },
        {
          "refId": "B",
          "instant": true,
          "format": "table",
          "expr": "max by (service) (probe_duration_seconds{job=\"services\"})"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "service": 0,
              "Value #A": 1,
              "Value #B": 2
            },
            "renameByName": {
              "service": "Service",
              "Value #A": "State",
              "Value #B": "Response time"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Down",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "Up",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Response time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Service",
            "desc": false
          }
        ]
      }
